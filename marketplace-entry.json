{
  "id": "gimme-the-lint",
  "name": "gimme-the-lint",
  "displayName": "Gimme The Lint",
  "type": "claude-plugin",
  "version": "2.0.0",
  "description": "Polyglot progressive linting for monorepos — adapter-driven baselines, per-app drift detection, and idempotent skips across JavaScript/TypeScript, Python, Go, and Rust.",
  "author": {
    "name": "TheGlitchKing"
  },
  "repository": {
    "type": "github",
    "owner": "TheGlitchKing",
    "repo": "gimme-the-lint",
    "url": "https://github.com/TheGlitchKing/gimme-the-lint"
  },
  "source": {
    "type": "npm",
    "package": "@theglitchking/gimme-the-lint"
  },
  "installation": {
    "methods": [
      {
        "type": "npm",
        "command": "npm install --save-dev @theglitchking/gimme-the-lint && npx gimme-the-lint install"
      },
      {
        "type": "npx",
        "command": "npx @theglitchking/gimme-the-lint install"
      },
      {
        "type": "claude-marketplace",
        "command": "/plugin install TheGlitchKing/gimme-the-lint"
      },
      {
        "type": "github-action",
        "uses": "TheGlitchKing/gimme-the-lint@v1"
      }
    ],
    "requirements": {
      "node": ">=18.0.0",
      "python": ">=3.8 (optional, for backend linting)",
      "claude-code": ">=1.0.0"
    }
  },
  "category": "productivity",
  "tags": ["linting", "progressive-linting", "polyglot", "monorepo", "git-hooks", "drift-detection", "github-action", "claude-plugin", "eslint", "ruff", "golangci-lint", "clippy"],
  "keywords": ["linting", "progressive", "baseline", "drift-detection", "polyglot", "monorepo", "git-hooks", "github-action", "eslint", "ruff", "golangci-lint", "go", "clippy", "rust", "python", "javascript", "typescript"],
  "license": "MIT",
  "homepage": "https://github.com/TheGlitchKing/gimme-the-lint",
  "status": "production-ready",
  "features": {
    "commands": ["/lint", "/lint:status", "/lint:baseline"],
    "hooks": []
  }
}
